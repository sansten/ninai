# Edge/local-first deployment profile for Ninai
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

API_PREFIX=/api/v1

# Edge mode toggles
DEPLOYMENT_MODE=edge
LOCAL_FIRST_MODE=true
ORG_FEDERATED_LOGIN_ENABLED=false

# Core data services
DATABASE_URL=postgresql+asyncpg://ninai:ninai@postgres:5432/ninai
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Local model serving
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_STRATEGY=llm

# Security
SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
