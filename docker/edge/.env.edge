# Edge/local-first deployment profile for Ninai
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

API_PREFIX=/api/v1

# Edge mode toggles
DEPLOYMENT_MODE=edge
LOCAL_FIRST_MODE=true
ORG_FEDERATED_LOGIN_ENABLED=false

# Core data services
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ninai
POSTGRES_PASSWORD=ninai
POSTGRES_DB=ninai

# SQLAlchemy/asyncpg connection pool (validated stable baseline)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_USE_LIFO=true

REDIS_URL=redis://redis:6379/0
GRAPH_REDIS_URL=redis://falkordb:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=2.5

# Local model serving
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_STRATEGY=llm

# Security
SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
