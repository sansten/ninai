# Ninai Backend Environment Configuration
# Copy this file to .env and edit values as needed

# Application
APP_NAME=Ninai
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ninai
POSTGRES_PASSWORD=ninai_dev_password
POSTGRES_DB=ninai

# Set to 1 when Docker services are running to enable DB-backed integration tests.
# Without this, tests that require Postgres are auto-skipped rather than failing.
RUN_POSTGRES_TESTS=1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
PERMISSION_CACHE_TTL=300
SHORT_TERM_TTL=604800

# Short-term memory promotion strategy: "count", "spacing", "hybrid"
STM_PROMOTION_STRATEGY=spacing
STM_ACCESS_COUNT_THRESHOLD=3
STM_MIN_ACCESS_SPACING_HOURS=6.0
STM_IMPORTANCE_THRESHOLD=0.7

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embedding — local Ollama provider (nomic-embed-text, 768 dims)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Ollama LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_FAST=qwen2.5:0.5b
OLLAMA_MODEL_PLANNING=qwen2.5:7b
OLLAMA_MODEL_DISTILLATION=qwen2.5:7b
OLLAMA_MODEL_BOUNDARY=qwen2.5:0.5b
OLLAMA_MODEL_UNCERTAINTY=qwen2.5:0.5b
OLLAMA_MODEL_AGENTS=qwen2.5:7b
SUMMARY_PROMPT=Summarize the following customer support memories for long-term storage:
